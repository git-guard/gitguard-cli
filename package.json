{
  "name": "@gitguard/cli",
  "version": "1.3.7",
  "description": "GitGuard CLI - Security scanning for developers",
  "main": "dist/index.js",
  "bin": {
    "gitguard": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "scan": "node dist/index.js scan",
    "prepublishOnly": "pnpm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "security",
    "scanner",
    "cli",
    "vulnerability",
    "code-analysis",
    "static-analysis"
  ],
  "author": "GitGuard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/git-guard/gitguard-cli.git"
  },
  "bugs": {
    "url": "https://github.com/git-guard/gitguard-cli/issues"
  },
  "homepage": "https://gitguard.net",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "commander": "^14.0.3",
    "ignore": "^7.0.6",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@9.15.6"
}
